# ---------------------------------------------------------------------------
# アプリの実行に必要な設定
# 実際の値は .env.local に置く (.gitignore 済み。絶対にコミットしない)
# ---------------------------------------------------------------------------

# Supabase の Project URL と公開キー (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service Role Key はサーバー側 (月次締めジョブ・運用スクリプト) でのみ使用。
# クライアントへ絶対に露出させない
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Vercel Cron からの月次締め呼び出しを認証するための共有シークレット
CRON_SECRET=change-me

# ---------------------------------------------------------------------------
# 初期セットアップ・検証スクリプト用 (アプリ実行には不要)
# ---------------------------------------------------------------------------

# プロジェクト参照ID (Project URL の https://<ここ>.supabase.co)
SUPABASE_PROJECT_REF=your-project-ref

# 個人アクセストークン (Account Settings → Access Tokens)。
# DB へ直接 TCP 接続できない環境から SQL を適用するために使う
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxx

# デモユーザー共通のパスワード (npm run seed:users で設定される)
DEMO_USER_PASSWORD=set-a-strong-password
